# 📜 第三部分：高效能智慧型 Bot AI 模組 (Bot AI System)

請在 **Place B (Match)** 的 `ServerScriptService` 下創建名為 `BotAISystem` 的伺服器腳本（Script）：

```lua
--!strict
-- Place B: BotAISystem.server.luau
local Players = game:GetService("Players")
local ArenaFolder = workspace:WaitForChild("ArenaFolder")

local CELL_SIZE = 4
local MIN_X, MAX_X = -37, 37
local MIN_Z, MAX_Z = -25, 24

-- 模擬炸彈危險區域矩陣
local DangerMatrix = {}

local function initDangerMatrix()
	for x = MIN_X, MAX_X do
		DangerMatrix[x] = {}
		for z = MIN_Z, MAX_Z do
			DangerMatrix[x][z] = false -- true 代表此格正處於炸彈十字十字火焰擴張範圍內
		end
	end
end

-- 掃描全場炸彈，更新危險矩陣 (全面取代每影格高耗能的物理 Raycast 射線檢測)
local function updateDangerZones()
	initDangerMatrix()
	local allChildren = workspace:GetChildren() -- 假設局內炸彈實例直接生成於 workspace 下並命名為 "Bomb"
	
	for _, obj in ipairs(allChildren) do
		if obj.Name == "Bomb" and obj:IsA("BasePart") then
			local bX = math.round(obj.Position.X / CELL_SIZE)
			local bZ = math.round(obj.Position.Z / CELL_SIZE)
			
			-- 假設炸彈爆炸十字半徑為 4 格
			local radius = 4
			for i = -radius, radius do
				if bX + i >= MIN_X and bX + i <= MAX_X then
					DangerMatrix[bX + i][bZ] = true
				end
				if bZ + i >= MIN_Z and bZ + i <= MAX_Z then
					DangerMatrix[bX][bZ + i] = true
				end
			end
		end
	end
end

-- 智商決策延遲控制 (難度控制核心變數)
local DifficultySettings = {
	["Easy"]   = { ReactionDelay = 0.65, ErrorRate = 35 },
	["Normal"] = { ReactionDelay = 0.30, ErrorRate = 12 },
	["Hard"]   = { ReactionDelay = 0.08, ErrorRate = 0  }
}

-- 核心智慧 NPC 行為控制迴圈
local function runBotLogic(botModel: Model, diffMode: string)
	local hum = botModel:FindFirstChildOfClass("Humanoid")
	local root = botModel:FindFirstChild("HumanoidRootPart") :: BasePart
	if not hum or not root then return end
	
	local config = DifficultySettings[diffMode] or DifficultySettings["Normal"]
	
	task.spawn(function()
		while botModel.Parent do
			task.wait(config.ReactionDelay)
			updateDangerZones()
			
			local currentX = math.round(root.Position.X / CELL_SIZE)
			local currentZ = math.round(root.Position.Z / CELL_SIZE)
			
			-- 邊界防禦與數據安全校驗
			if not _G.GridDataMatrix[currentX] or _G.GridDataMatrix[currentX][currentZ] == nil then
				continue
			end
			
			-- 1. 避險逃生檢查：如果目前格子處於危險範圍內，立刻尋找安全方塊逃離
			if DangerMatrix[currentX][currentZ] == true then
				local directions = {
					Vector2.new(1, 0), Vector2.new(-1, 0),
					Vector2.new(0, 1), Vector2.new(0, -1)
				}
				
				local escapeTarget: Vector2? = nil
				for _, dir in ipairs(directions) do
					local nextX = currentX + dir.X
					local nextY = currentZ + dir.Y
					
					-- 檢查該目標格在二維矩陣中是否為通路、非虛空且安全
					if _G.GridDataMatrix[nextX] and _G.GridDataMatrix[nextX][nextY] == 0 then
						if DangerMatrix[nextX][nextY] == false then
							-- 模擬低智商出錯機率
							if math.random(1, 100) > config.ErrorRate then
								escapeTarget = Vector2.new(nextX, nextY)
								break
							end
						end
					end
				end
				
				if escapeTarget then
					hum:MoveTo(Vector3.new(escapeTarget.X * CELL_SIZE, root.Position.Y, escapeTarget.Y * CELL_SIZE))
					continue
				end
			end
			
			-- 2. 進攻放彈邏輯：周圍有木箱(1)或有真人玩家時，有機率主動安放炸彈
			local adjacentOffsets = { Vector2.new(1,0), Vector2.new(-1,0), Vector2.new(0,1), Vector2.new(0,-1) }
			local shouldDropBomb = false
			
			for _, offset in ipairs(adjacentOffsets) do
				local targetX = currentX + offset.X
				local targetZ = currentZ + offset.Y
				
				if _G.GridDataMatrix[targetX] and _G.GridDataMatrix[targetX][targetZ] == 1 then
					shouldDropBomb = true -- 發現可破壞方塊
					break
				end
			end
			
			if shouldDropBomb and DangerMatrix[currentX][currentZ] == false then
				-- 呼叫局內放彈函數 (在此模擬按下放彈鍵)
				-- [此處串接您的放彈生成邏輯：SpawnBombFunction(root.Position)]
				print(botModel.Name .. " 在安全的前提下成功安放了一枚戰術炸彈！")
			end
			
			-- 3. 尋路自由巡邏遊走
			if hum.WalkToPoint == Vector3.new(0,0,0) or (root.Position - hum.WalkToPoint).Magnitude < 2 then
				local randDir = adjacentOffsets[math.random(1, #adjacentOffsets)]
				local walkX = currentX + randDir.X * 3
				local walkZ = currentZ + randDir.Y * 3
				
				if _G.GridDataMatrix[walkX] and _G.GridDataMatrix[walkX][walkZ] == 0 then
					hum:MoveTo(Vector3.new(walkX * CELL_SIZE, root.Position.Y, walkZ * CELL_SIZE))
				end
			end
		end
	end)
end

-- 4. 全局注冊 NPC 機器人動態工廠生成函數
_G.SpawnNPCAIOpponents = function(count: number, difficulty: string)
	print("正在生成智慧補位 NPC，數量：" .. tostring(count) .. "，智商等級：" .. difficulty)
	for i = 1, count do
		local bot = Instance.new("Model")
		bot.Name = "🔥_Bot對手_" .. tostring(i)
		bot.Parent = workspace
		
		local root = Instance.new("Part")
		root.Name = "HumanoidRootPart"
		root.Size = Vector3.new(2, 2, 2)
		-- 隨機分散生成於靠近地圖右側的安全網格內
		root.Position = Vector3.new(math.random(10, 30) * CELL_SIZE, 3, math.random(-10, 10) * CELL_SIZE)
		root.CanCollide = true
		root.Parent = bot
		bot.PrimaryPart = root
		
		local hum = Instance.new("Humanoid")
		hum.MaxHealth = 100
		hum.Health = 100
		hum.WalkSpeed = 12
		hum.Parent = bot
		
		runBotLogic(bot, difficulty)
		
		-- 處理 Bot 被炸彈擊殺淘汰時的清除機制
		hum.Died:Connect(function()
			print(bot.Name .. " 已被炸彈成功淘汰！")
			task.wait(1.5)
			bot:Destroy()
		end)
	end
end

