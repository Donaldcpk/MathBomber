-- 3. 10 種全新型態 PVP 地圖生成矩陣演算法
local function buildArena(mapIndex: number)
	ArenaFolder:ClearAllChildren()
	setupArenaFloor()
	initGridMatrix()
	
	print("正在動態建構高規格 PVP 地圖編號：" .. tostring(mapIndex))
	
	for x = MIN_X, MAX_X do
		for z = MIN_Z, MAX_Z do
			-- 排除玩家安全起始點周圍格子
			if math.abs(x - PLAYER_SAFE_X) <= 3 and math.abs(z - PLAYER_SAFE_Z) <= 3 then
				continue
			end
			
			local isBlock = false
			local blockType = "Normal" -- Normal, Steel, Conveyor, Mirror, Void
			
			if mapIndex == 1 then
				-- Map 1: 經典網格 (奇數交替放置鋼鐵方塊)
				if x % 2 ~= 0 and z % 2 ~= 0 then
					isBlock = true
					blockType = "Steel"
				end
			elseif mapIndex == 2 then
				-- Map 2: 傳送帶工廠 (特定線路變更為傳送帶)
				if z % 6 == 0 and x % 3 ~= 0 then
					isBlock = true
					blockType = "Conveyor"
				end
			elseif mapIndex == 3 then
				-- Map 3: 萬花筒迷宮 (斜角稜鏡分流結構)
				if math.abs(x) == math.abs(z) and x % 4 == 0 then
					isBlock = true
					blockType = "Mirror"
				end
			elseif mapIndex == 5 then
				-- Map 5: 算術網格塌陷 (邊緣不穩定格)
				if (x == MIN_X or x == MAX_X or z == MIN_Z or z == MAX_Z) and (x+z) % 2 == 0 then
					isBlock = true
					blockType = "Void"
				end
			else
				-- 預設常規隨機障礙物
				if math.random(1, 100) <= 15 then
					isBlock = true
				end
			end
			
			if isBlock then
				local part = Instance.new("Part")
				part.Size = Vector3.new(CELL_SIZE, 4, CELL_SIZE)
				part.Position = Vector3.new(x * CELL_SIZE, 2, z * CELL_SIZE)
				part.Anchored = true
				
				if blockType == "Steel" then
					part.Color = Color3.fromRGB(150, 150, 150)
					part.Material = Enum.Material.DiamondPlate
					_G.GridDataMatrix[x][z] = 2 -- 2 代表不可破壞鋼鐵
				elseif blockType == "Conveyor" then
					part.Color = Color3.fromRGB(200, 100, 0)
					part.Material = Enum.Material.Fabric
					part.Size = Vector3.new(CELL_SIZE, 0.2, CELL_SIZE)
					part.Position = Vector3.new(x * CELL_SIZE, 0.1, z * CELL_SIZE)
					_G.GridDataMatrix[x][z] = 3 -- 3 代表傳送帶特殊網格
				elseif blockType == "Void" then
					part.Color = Color3.fromRGB(20, 0, 40)
					part.Material = Enum.Material.Neon
					part.Size = Vector3.new(CELL_SIZE, 0.1, CELL_SIZE)
					part.Position = Vector3.new(x * CELL_SIZE, 0.05, z * CELL_SIZE)
					_G.GridDataMatrix[x][z] = -1 -- -1 代表虛空死區
				else
					part.Color = Color3.fromRGB(139, 69, 19)
					part.Material = Enum.Material.Wood
					_G.GridDataMatrix[x][z] = 1 -- 1 代表可破壞木箱
				end
				part.Parent = ArenaFolder
			end
		end
	end
end

-- 4. PVE 30關動態 Boss 生成 (徹底解決漂浮與血量同步 Bug)
local function spawnPVEBoss(level: number)
	-- 動態遞增曲線公式
	local maxHp = 150 + (level - 1) * 36
	local speed = 4.0 + (level - 1) * 0.26
	
	local boss = Instance.new("Model")
