	root.Anchored = false
	root.CanCollide = true
	root.Parent = boss
	boss.PrimaryPart = root
	
	local hum = Instance.new("Humanoid")
	hum.MaxHealth = maxHp
	hum.Health = maxHp
	hum.WalkSpeed = math.min(speed, 15) -- 封頂上限速度 15
