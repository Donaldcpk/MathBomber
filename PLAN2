# 📜 第一部分：大廳核心管理器 (Lobby Manager)

請在 **Place A (Lobby)** 的 `ServerScriptService` 下創建名為 `LobbyManager` 的伺服器腳本（Script）：

```lua
--!strict
-- Place A: LobbyManager.server.luau
local DataStoreService = game:GetService("DataStoreService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local TeleportService = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local PlayerDataStore = DataStoreService:GetDataStore("MathBomber_Prod_v1")
local RoomCodeMap = MemoryStoreService:GetHashMap("PrivateRooms_v1")

-- 替換為您的 Place B (Match Place) 的實際 ID
local MATCH_PLACE_ID = 1234567890 -- [請在此處修改為您的副本 PlaceId]

-- 初始化遠端事件
local Remotes = ReplicatedStorage:FindFirstChild("Remotes") or Instance.new("Folder")
Remotes.Name = "Remotes"
Remotes.Parent = ReplicatedStorage

local CreateRoomEvent = Remotes:FindFirstChild("CreateRoom") or Instance.new("RemoteEvent")
CreateRoomEvent.Name = "CreateRoom"
CreateRoomEvent.Parent = Remotes

local JoinRoomEvent = Remotes:FindFirstChild("JoinRoom") or Instance.new("RemoteEvent")
JoinRoomEvent.Name = "JoinRoom"
JoinRoomEvent.Parent = Remotes

local QuickMatchEvent = Remotes:FindFirstChild("QuickMatch") or Instance.new("RemoteEvent")
QuickMatchEvent.Name = "QuickMatch"
QuickMatchEvent.Parent = Remotes

-- 1. 玩家加入與 Session Locking 數據載入 (消除競爭條件)
Players.PlayerAdded:Connect(function(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local gold = Instance.new("IntValue")
	gold.Name = "Gold"
	gold.Value = 0
	gold.Parent = leaderstats

	local unlockedLevel = Instance.new("IntValue")
	unlockedLevel.Name = "UnlockedLevel"
	unlockedLevel.Value = 1
	unlockedLevel.Parent = player

	local userId = tostring(player.UserId)
	local success, data = pcall(function()
		return PlayerDataStore:GetAsync(userId)
	end)

	if success and data then
		-- 檢查 Session Lock 狀態，防止惡意刷錢
		if data.SessionLocked == true then
			warn("警告：玩家數據處於鎖定狀態，可能在上一個伺服器未正常儲存。")
		end
		gold.Value = data.Gold or 0
		unlockedLevel.Value = data.UnlockedLevel or 1
	else
		-- 新玩家初始化
		local defaultData = { Gold = 100, UnlockedLevel = 1, SessionLocked = false }
		pcall(function() PlayerDataStore:SetAsync(userId, defaultData) end)
		gold.Value = 100
		unlockedLevel.Value = 1
	end
end)

-- 2. 隨機生成 6 位數房間號 (防碰撞機制)
local function generateUniqueRoomCode(): string
	local code = ""
	local attempts = 0
	repeat
		attempts += 1
		code = string.format("%06d", math.random(0, 999999))
		-- 去 MemoryStore 檢查此號碼是否已被佔用
		local exists = pcall(function()
			return RoomCodeMap:GetAsync(code)
		end)
		if not exists then
			break
		end
	until attempts > 50
	return code
end

-- 3. 異步安全傳送與數據鎖定鎖
local function teleportPlayerWithData(player: Player, teleportOptions: TeleportOptions)
	local userId = tostring(player.UserId)
	
	-- 傳送前實施 Session Lock 鎖定
	pcall(function()
		PlayerDataStore:UpdateAsync(userId, function(oldData)
			if oldData then
				oldData.SessionLocked = true
			end
			return oldData
		end)
	end)
	
	local success, err = pcall(function()
		TeleportService:TeleportAsync(MATCH_PLACE_ID, {player}, teleportOptions)
	end)
	
	if not success then
		warn("傳送失敗: " .. tostring(err))
		-- 傳送失敗時解鎖
		pcall(function()
			PlayerDataStore:UpdateAsync(userId, function(oldData)
				if oldData then oldData.SessionLocked = false end
				return oldData
			end)
		end)
	end
end

-- 4. 創建自訂房間事件處理
CreateRoomEvent.OnServerEvent:Connect(function(player)
	local roomCode = generateUniqueRoomCode()
	local reserveCode = TeleportService:ReserveServer(MATCH_PLACE_ID)
	
	local roomData = {
		AccessCode = reserveCode,
		HostId = player.UserId,
		Status = "Waiting"
	}
	
	-- 寫入跨服記憶體快取，有效期限 3600 秒 (1小時)
	local success = pcall(function()
		RoomCodeMap:SetAsync(roomCode, HttpService:JSONEncode(roomData), 3600)
	end)
	
	if success then
		-- 通知客戶端房間創建成功與顯示 6 位數房間號
		CreateRoomEvent:FireClient(player, roomCode)
		
		-- 3秒後自動將房長傳送至專屬保留伺服器副本
		task.wait(3)
		local options = Instance.new("TeleportOptions")
		options.ReservedServerAccessCode = reserveCode
		
		local teleportData = { Mode = "PVP_Room", RoomCode = roomCode, HostId = player.UserId }
		options:SetTeleportData(teleportData)
		teleportPlayerWithData(player, options)
	else
		warn("MemoryStore 寫入失敗，請重試。")
	end
end)

-- 5. 加入自訂房間事件處理 (含狀態鎖定檢查)
JoinRoomEvent.OnServerEvent:Connect(function(player, roomCode: string)
	local success, roomDataStr = pcall(function()
		return RoomCodeMap:GetAsync(roomCode)
	end)
	
	if success and roomDataStr then
		local HttpService = game:GetService("HttpService")
		local roomData = HttpService:JSONDecode(roomDataStr)
		
		if roomData.Status == "InGame" then
			-- 若對戰已開打，拒絕非法闖入
			JoinRoomEvent:FireClient(player, "FAILED_IN_GAME")
			return
		end
		
		local options = Instance.new("TeleportOptions")
		options.ReservedServerAccessCode = roomData.AccessCode
		
		local teleportData = { Mode = "PVP_Room", RoomCode = roomCode, HostId = roomData.HostId }
		options:SetTeleportData(teleportData)
		teleportPlayerWithData(player, options)
	else
		JoinRoomEvent:FireClient(player, "NOT_FOUND")
	end
end)

